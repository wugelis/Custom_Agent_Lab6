@model RegisterViewModel
@{
    ViewData["Title"] = "會員註冊";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-person-plus-fill" style="font-size: 3rem; color: var(--primary-color);"></i>
                        <h2 class="mt-3">會員註冊</h2>
                        <p class="text-muted">建立您的 RentalCar 帳戶</p>
                    </div>

                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="mb-3">
                            <label asp-for="Username" class="form-label">
                                <i class="bi bi-person"></i> 用戶名稱
                            </label>
                            <input asp-for="Username" class="form-control" placeholder="請輸入用戶名稱" required />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">
                                <i class="bi bi-envelope"></i> 電子郵件
                            </label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="your@email.com" required />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">
                                <i class="bi bi-lock"></i> 密碼
                            </label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="請輸入密碼" required />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label">
                                <i class="bi bi-lock-fill"></i> 確認密碼
                            </label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="請再次輸入密碼" required />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle"></i> 立即註冊
                            </button>
                        </div>
                    </form>

                    <div class="text-center mt-4">
                        <p class="mb-0">
                            已有帳號？
                            <a asp-action="Login" class="text-decoration-none">
                                立即登入 <i class="bi bi-arrow-right"></i>
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
