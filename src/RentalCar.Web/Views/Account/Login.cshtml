@model LoginViewModel
@{
    ViewData["Title"] = "會員登入";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-box-arrow-in-right" style="font-size: 3rem; color: var(--primary-color);"></i>
                        <h2 class="mt-3">會員登入</h2>
                        <p class="text-muted">登入您的帳戶</p>
                    </div>

                    <form asp-action="Login" method="post">
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="mb-3">
                            <label asp-for="Username" class="form-label">
                                <i class="bi bi-person"></i> 用戶名稱
                            </label>
                            <input asp-for="Username" class="form-control" placeholder="請輸入用戶名稱" required autofocus />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label">
                                <i class="bi bi-lock"></i> 密碼
                            </label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="請輸入密碼" required />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-box-arrow-in-right"></i> 登入
                            </button>
                        </div>
                    </form>

                    <div class="text-center mt-4">
                        <p class="mb-0">
                            還沒有帳號？
                            <a asp-action="Register" class="text-decoration-none">
                                立即註冊 <i class="bi bi-arrow-right"></i>
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
